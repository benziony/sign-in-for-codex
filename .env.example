# Optional test/development override. Production defaults to
# ~/Library/Application Support/sign-in-for-codex.
SIGN_IN_FOR_CODEX_HOME=/absolute/path/to/a/private/runtime-directory

# Optional skill location override. The installer otherwise uses
# ~/.codex/skills (or $CODEX_HOME/skills when CODEX_HOME is set).
SIGN_IN_FOR_CODEX_SKILLS_DIR=/absolute/path/to/a/codex-skills-directory
